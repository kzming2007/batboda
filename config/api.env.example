# API environment template for the hackathon prototype.
# Do not put real credentials in this example file.
# After the Antigravity source is inspected, copy this file to the app root
# as .env.local and enter the real value only in that local file.
# Use the data.go.kr General Authentication Key (Decoding).

PUBLIC_DATA_MODE=mock
DATA_GO_KR_SERVICE_KEY=

# 설명 생성 제공자 (선택)
# none      : 제공자 없음. 규칙 기반 설명만 사용 (기본값)
# gemini    : Google Gemini 실시간 호출. GEMINI_API_KEY가 있을 때만 등록된다
# replay    : 저장해 둔 실호출 응답 재생. 사람이 쓴 문장은 넣지 않는다
# curated   : 예시 문안 주입. 실제 LLM이 아니며 화면에 '예시 문안'으로 표시된다
# tampered  : 규칙 위반 문장 주입. 검증이 막는지 확인하는 시연용
# anthropic : Claude 실시간 호출. ANTHROPIC_API_KEY가 있을 때만 등록된다
LLM_PROVIDER=none

# Google AI Studio 키 (https://aistudio.google.com/apikey)
# gemini-2.5-flash는 2026-08-04부터 신규 프로젝트에서 404로 거부된다.
# gemini-3.6-flash와 별칭 gemini-flash-latest는 thinkingBudget:0을 거부해 호출이 4.6초로 늘어난다.
# gemini-3.5-flash는 사고를 끌 수 있어 1.4초로 끝난다(실측). 모델을 바꿀 때 이 값을 먼저 확인할 것.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

ANTHROPIC_API_KEY=
